<!-- https://clickhouse.com/docs/en/operations/tips#using-less-than-16gb-of-ram -->
<clickhouse>

	<!-- Global memory limit - leave some for OS -->
	<max_server_memory_usage>6442450944</max_server_memory_usage> <!-- 6GB -->
	<max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio> <!-- 75% of 8GB = 6GB -->

	<!-- https://clickhouse.com/docs/en/operations/server-configuration-parameters/settings#mark_cache_size -->
	<mark_cache_size>524288000</mark_cache_size>

	<!-- Disable all system logs -->
	<text_log remove="true"/>
	<query_log remove="true"/>
	<query_thread_log remove="true"/>
	<processors_profile_log remove="true"/>
	<trace_log remove="true"/>
	<metric_log remove="true"/>
	<asynchronous_metric_log remove="true"/>
	<part_log remove="true"/>
	<query_metric_log remove="true"/>
	<error_log remove="true"/>
	<opentelemetry_span_log remove="true"/>
	<session_log remove="true"/>
	<transaction_log remove="true"/>
	<zookeeper_log remove="true"/>
</clickhouse>